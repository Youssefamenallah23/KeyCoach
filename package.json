{
  "name": "keycoach",
  "version": "0.1.0",
  "private": true,
  "description": "KeyCoach - an AI-assisted piano learning simulator that runs on a computer keyboard only. Deterministic MVP v1.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "selftest": "tsc -p tsconfig.selftest.json && node scripts/selftest.cjs",
    "simulate": "tsc -p tsconfig.selftest.json && node scripts/simulate.cjs",
    "agents-compare": "tsc -p tsconfig.selftest.json && node scripts/agents-compare.cjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}