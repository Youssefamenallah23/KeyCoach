# Copy this file to .env.local and fill in one key.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. This template is not, so keep real keys out of it.
#
# With no key set the app still works completely. Every answer comes from the
# deterministic analyser in code, with no network call and no cost. The model is
# used only to phrase sentences, never to score, time, plan or validate.
#
# After editing .env.local, restart the dev server.

# --- Option A: OpenAI (checked first if both are set) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Option B: Google Gemini (generous free tier) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Alias accepted in place of GEMINI_API_KEY:
# GOOGLE_API_KEY=
